  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:turbo": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "build:static": "NEXT_STATIC_EXPORT=1 next build",
    "mobile:build": "node scripts/build-mobile.mjs",
    "mobile:build:android:release": "node scripts/build-android-release.mjs",
    "mobile:build:ios:release": "node scripts/build-ios-release.mjs",
    "mobile:sync": "cap sync",
    "mobile:open:android": "open -a 'Android Studio' android",
    "mobile:open:ios": "cap open ios",
    "build:sdk": "node scripts/build-sdk.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e:all": "playwright test --config=playwright.config.ts",
    "test:e2e:aftersales": "pnpm test:e2e:p0",
    "test:e2e:p0": "playwright test --config=playwright.config.ts production-ai-routing.live.spec.ts aftersales-closed-loop.live.spec.ts",
    "test:e2e:routing": "playwright test --config=playwright.config.ts production-ai-routing.live.spec.ts",
    "test:e2e:closed-loop": "playwright test --config=playwright.config.ts aftersales-closed-loop.live.spec.ts",
    "test:e2e:adversarial": "playwright test --config=playwright.config.ts aftersales-adversarial.live.spec.ts",
    "test:e2e:capability": "playwright test --config=playwright.config.ts aftersales-capability.live.spec.ts",
    "test:e2e:ui-quality": "playwright test --config=playwright.config.ts aftersales-ui-quality.live.spec.ts",
    "test:e2e:login-prefill": "playwright test --config=playwright.config.ts login-prefill.live.spec.ts",
    "test:e2e:partner-isolation": "playwright test --config=playwright.config.ts partner-engineer-isolation.live.spec.ts",
    "test:e2e:language": "playwright test --config=playwright.config.ts conversation-language.live.spec.ts",
    "test:e2e:workflow": "playwright test --config=playwright.config.ts workflow-product.live.spec.ts"
  },
