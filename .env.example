# ===== PostgreSQL =====
POSTGRES_DB=cs_ai_agent
POSTGRES_USER=cs_ai_agent
POSTGRES_PASSWORD=change_me_in_production

# Required only when a new database creates the initial platform administrator.
RHD_BOOTSTRAP_ADMIN_PASSWORD=change_me_with_at_least_12_random_characters

# ===== Redis =====
REDIS_PASSWORD=change_me_in_production

# ===== MinIO private object storage =====
MINIO_ROOT_USER=change_me_in_production
MINIO_ROOT_PASSWORD=change_me_in_production
# Public HTTPS endpoint used in browser-facing signed URLs, for example https://files.example.com.
MINIO_PUBLIC_ENDPOINT=https://files.example.com
MINIO_BUCKET=remotehelpdesk-assets
MINIO_REGION=us-east-1
MINIO_SIGNED_URL_EXPIRE_SECONDS=600

# File containing the Alertmanager webhook URL. Keep it outside the repository.
ALERT_WEBHOOK_URL_FILE=/run/remotehelpdesk-secrets/alert-webhook-url

# ===== Jitsi（由其他团队维护）=====
JITSI_URL=https://jitsi.example.com
JITSI_DOMAIN=jitsi.example.com
JITSI_APP_ID=remotehelpdesk
JITSI_APP_SECRET=change_me_in_production
JITSI_WEBHOOK_SECRET=change_me_in_production
JITSI_REQUIRE_AUTH=false
JITSI_TOKEN_TTL_MINUTES=7200

# ===== 科大讯飞实时语音转写（企业账号凭证仅放服务端）=====
SPEECH_PROVIDER=mock
SPEECH_MOCK_SEGMENT_DURATION_MS=2000
XFYUN_RTASR_APP_ID=
XFYUN_RTASR_API_KEY=
XFYUN_RTASR_ENDPOINT=wss://rtasr.xfyun.cn/v1/ws
# Optional iFlytek vertical-domain code. Leave empty for the general model.
XFYUN_RTASR_DOMAIN=
XFYUN_TRANSLATION_ENABLED=false
XFYUN_TRANSLATION_API_SECRET=
XFYUN_TRANSLATION_ENDPOINT=https://itrans.xfyun.cn/v2/its
XFYUN_TRANSLATION_TARGET_LANGUAGE=en
# Enables the server-side Jigasi audio gateway. Use the same random secret in
# the Jigasi Whisper URL and SEND_JSON_REMOTE_URLS callback URL.
SPEECH_JIGASI_ENABLED=false
SPEECH_JIGASI_SHARED_SECRET=change_me_with_at_least_32_random_characters
SPEECH_JIGASI_MAX_PARTICIPANT_STREAMS=8
SPEECH_JIGASI_MAX_CONCURRENT_STREAMS=32

# ===== 会议 AR 部件识别（实现 Provider 后启用）=====
MEETING_AR_PROVIDER=disabled
MEETING_AR_ENDPOINT=
MEETING_AR_API_KEY=
MEETING_AR_HEALTH_PATH=/health

# ===== Sub2API（外部 AI 服务）=====
SUB2API_BASE_URL=https://sub2api.example.com
# 平台管理 API Key；使用 Sub2API settings.admin_api_key，不要填普通用户/模型 API Key。
# 启动时会加密同步入库并覆盖旧配置。
SUB2API_ADMIN_API_KEY=change_me_in_production
# 兼容旧部署。新环境优先使用 SUB2API_ADMIN_API_KEY；只有它本身就是管理 key 时才可作为兜底。
SUB2API_DEFAULT_KEY=change_me_in_production
SUB2API_DEFAULT_MODEL=replace_with_an_available_chat_model
# LLM auto 默认优先走 Sub2API；也可改为 database 兼容旧 AIConfig。
LLM_SOURCE=auto
SUB2API_LLM_MODEL=replace_with_an_available_chat_model
# Optional secondary OpenAI-compatible LLM. It uses OPENAI_API_KEY/BASE_URL
# and is called only when the primary LLM provider fails.
LLM_FALLBACK_MODEL=
LLM_FALLBACK_TIMEOUT=30s
LLM_FAILOVER_ATTEMPT_TIMEOUT=15s
LLM_FAILOVER_CIRCUIT_COOLDOWN=60s

# ===== Embedding 模型（百炼 / OpenAI-compatible）=====
# auto: 优先数据库 AIConfig，其次下方 EMBEDDING_* 环境模型；sub2api: 显式使用租户 Sub2API key。
EMBEDDING_SOURCE=auto
EMBEDDING_API_KEY=change_me_in_production
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
SUB2API_EMBEDDING_MODEL=
SUB2API_EMBEDDING_DIM=
MODEL_REASONING_EFFORT=xhigh

# ===== 对象存储 =====
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=

# ===== 应用 =====
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change_me_in_production
CUSTOMER_SESSION_SECRET=change_me_in_production
# At least 32 random characters. Protects the built-in Streamable HTTP MCP endpoint.
MCP_SERVER_TOKEN=change_me_with_at_least_32_random_characters
TZ=Asia/Shanghai
