# Copy this file to .env.local and replace the placeholders.
# Use a normal sub2api user key, never an administrator key.
SUB2API_BASE_URL=https://your-sub2api.example.com
SUB2API_API_KEY=your-user-api-key
SUB2API_DEFAULT_MODEL=your-available-model

# Helpdesk Go service (used by --helpdesk-reply)
HELPDESK_GO_URL=http://127.0.0.1:8083
AI_PHONE_SERVICE_TOKEN=replace_with_the_same_32_plus_char_service_token
AI_PHONE_LINE_ID=line-1
AI_PHONE_PROJECT_KEY=support
# Optional sounddevice indexes; leave empty to use the Windows defaults.
# AI_PHONE_INPUT_DEVICE=1
# AI_PHONE_OUTPUT_DEVICE=3
# Optional durable ticket task snapshots
# AI_PHONE_TASK_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/database
# AI_PHONE_TASK_STORE=auto
