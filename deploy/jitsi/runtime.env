# Non-secret production media settings. Existing credentials in the remote
# .env are preserved by scripts/apply-jitsi-production-tuning.sh.
JITSI_IMAGE_VERSION=stable-11146-2
ENABLE_CODEC_AV1=0
ENABLE_CODEC_VP8=1
ENABLE_CODEC_VP9=1
ENABLE_CODEC_H264=1
CODEC_ORDER_JVB='["VP8","H264","VP9"]'
CODEC_ORDER_JVB_MOBILE='["VP8","H264"]'
CODEC_ORDER_P2P='["VP8","H264","VP9"]'
CODEC_ORDER_P2P_MOBILE='["VP8","H264"]'
