#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'USAGE'
RemoteHelpDesk private deployment control

Usage:
  ./rhdctl [--env-file PATH] <command> [options]

Commands:
  init                 Create a protected .env and generate base secrets
  initialize-config --document PATH --tenant-name NAME
                       Explicitly initialize an empty instance from its raw configuration
                       Add --admin-user-id ID, or --admin-username USER --admin-password-file PATH when assigning its administrator
  sync-config-digest   Validate an existing instance bundle and repair its env digest
  preflight            Validate host, secrets, paths and Compose configuration
  install              Build and start a clean or existing private deployment
  upgrade              Backup, restore-drill, build and perform guarded cutover
  rollback             Restore the application images saved by the last upgrade
  doctor [--logs]      Check containers and HTTP readiness
  status               Show Compose service status
  logs [SERVICE]       Follow logs (all services when SERVICE is omitted)
  backup               Create a checksummed PostgreSQL backup
  restore-drill [FILE] Restore a backup into an isolated temporary database
  restore FILE --confirm DB_NAME
                       Replace the configured database after a safety backup
  monitoring-up        Start the optional Prometheus monitoring profile
  monitoring-status    Check Prometheus, Alertmanager and exporters
  monitoring-stop      Stop only the optional monitoring profile
  stop                 Stop application containers without deleting data

Global options:
  --env-file PATH      Use a non-default environment file
  -h, --help           Show this help
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --env-file)
      [[ $# -ge 2 ]] || { echo "ERROR: --env-file requires a path" >&2; exit 2; }
      export RHD_ENV_FILE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

command_name="${1:-}"
if [[ -z "$command_name" ]]; then
  usage
  exit 2
fi
shift

state_dir() {
  rhd_absolute_path "$(rhd_env_value RHD_STATE_DIR ./.state)"
}

backup_dir() {
  rhd_absolute_path "$(rhd_env_value RHD_BACKUP_DIR ./backups)"
}

data_dir() {
  rhd_absolute_path "$(rhd_env_value RHD_DATA_DIR ./volumes)"
}

metrics_dir() {
  rhd_absolute_path "$(rhd_env_value RHD_METRICS_DIR ./metrics)"
}

input_file_path() {
  local value="$1"
  case "$value" in
    /*) printf '%s' "$value" ;;
    *)
      local parent base
      parent="$(dirname "$value")"
      base="$(basename "$value")"
      printf '%s/%s' "$(cd "$parent" && pwd)" "$base"
      ;;
  esac
}

acquire_deploy_lock() {
  local lock_dir lock_pid lock_owner
  lock_dir="$(state_dir)/deploy.lock"
  mkdir -p "$(state_dir)"
  if ! mkdir "$lock_dir" 2>/dev/null; then
    lock_pid="$(sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' "$lock_dir/owner" 2>/dev/null || true)"
    if [[ -n "$lock_pid" ]] && ! kill -0 "$lock_pid" 2>/dev/null; then
      rhd_warn "recovering stale deployment lock from process ${lock_pid}"
      rm -f "$lock_dir/owner"
      rmdir "$lock_dir" 2>/dev/null || true
      mkdir "$lock_dir" 2>/dev/null || rhd_die "could not recover stale deployment lock"
    else
      lock_owner="$(sed -n '1p' "$lock_dir/owner" 2>/dev/null || true)"
      rhd_die "another deployment operation is active (${lock_owner:-owner unknown})"
    fi
  fi
  printf '%s pid=%s started=%s\n' "$(id -un 2>/dev/null || printf operator)" "$$" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$lock_dir/owner"
  RHD_LOCK_DIR="$lock_dir"
  trap 'status=$?; if [[ -n "${RHD_LOCK_DIR:-}" && "$RHD_LOCK_DIR" == *"/deploy.lock" ]]; then rm -f "$RHD_LOCK_DIR/owner"; rmdir "$RHD_LOCK_DIR" 2>/dev/null || true; fi; exit "$status"' EXIT
}

prepare_directories() {
  mkdir -p "$(data_dir)" "$(backup_dir)" "$(state_dir)" "$(metrics_dir)"
  chmod 700 "$(backup_dir)" "$(state_dir)" 2>/dev/null || true
  chmod 755 "$(metrics_dir)" 2>/dev/null || true
}

run_preflight() {
  bash "$SCRIPT_DIR/preflight.sh" --env-file "$RHD_ENV_FILE" --strict
}

run_doctor() {
  bash "$SCRIPT_DIR/doctor.sh" --env-file "$RHD_ENV_FILE" "$@"
}

run_backup() {
  local result_file status=0
  rhd_postgres_tool_environment
  prepare_directories
  result_file="$(mktemp "$(state_dir)/backup-result.XXXXXX")"
  (
    cd "$RHD_DEPLOY_DIR"
    BACKUP_RESULT_FILE="$result_file" BACKUP_METRICS_FILE="$(metrics_dir)/remotehelpdesk_backup.prom" \
      bash "$RHD_REPO_ROOT/scripts/backup-db.sh" "$(backup_dir)"
  ) || status=$?
  RHD_LAST_BACKUP="$(head -n 1 "$result_file")"
  rm -f "$result_file"
  [[ "$status" == 0 && -n "$RHD_LAST_BACKUP" && -s "$RHD_LAST_BACKUP" ]] || return 1
}

latest_backup() {
  local db_name
  db_name="$(rhd_env_value POSTGRES_DB cs_ai_agent)"
  find "$(backup_dir)" -maxdepth 1 -type f -name "${db_name}_*.dump" -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -n 1 | cut -d ' ' -f 2-
}

run_restore_drill() {
  local backup_file="${1:-}"
  if [[ -z "$backup_file" ]]; then
    backup_file="$(latest_backup)"
  else
    backup_file="$(input_file_path "$backup_file")"
  fi
  [[ -n "$backup_file" ]] || rhd_die "no PostgreSQL backup is available for a restore drill"
  [[ -s "$backup_file" ]] || rhd_die "backup is missing or empty: ${backup_file}"
  rhd_postgres_tool_environment
  (
    cd "$RHD_DEPLOY_DIR"
    RESTORE_DRILL_METRICS_FILE="$(metrics_dir)/remotehelpdesk_restore_drill.prom" \
      bash "$RHD_REPO_ROOT/scripts/drill-db-restore.sh" "$backup_file"
  )
}

monitoring_container_id() {
  rhd_monitoring_compose ps -aq "$1" 2>/dev/null | head -n 1
}

monitoring_status() {
  local errors=0 service container_id state
  for service in postgres-exporter redis-exporter node-exporter prometheus alertmanager; do
    container_id="$(monitoring_container_id "$service")"
    if [[ -z "$container_id" ]]; then
      printf 'FAIL  %-20s missing\n' "$service" >&2
      errors=$((errors + 1))
      continue
    fi
    state="$(rhd_service_state "$container_id")"
    case "$state" in
      running/healthy|running) printf 'PASS  %-20s %s\n' "$service" "$state" ;;
      *) printf 'FAIL  %-20s %s\n' "$service" "${state:-unknown}" >&2; errors=$((errors + 1)) ;;
    esac
  done
  if ! rhd_http_check "http://127.0.0.1:$(rhd_env_value PROMETHEUS_PORT 9090)/-/ready"; then
    rhd_warn "Prometheus readiness endpoint failed"
    errors=$((errors + 1))
  fi
  if ! rhd_http_check "http://127.0.0.1:$(rhd_env_value ALERTMANAGER_PORT 9093)/-/ready"; then
    rhd_warn "Alertmanager readiness endpoint failed"
    errors=$((errors + 1))
  fi
  [[ "$errors" == "0" ]] || return 1
}

save_rollback_state() {
  local api_image="$1"
  local web_image="$2"
  local state_file="$(state_dir)/rollback.env"
  {
    printf 'ROLLBACK_API_IMAGE=%s\n' "$api_image"
    printf 'ROLLBACK_WEB_IMAGE=%s\n' "$web_image"
    printf 'ROLLBACK_INSTANCE_ID=%s\n' "${RHD_INSTANCE_ID:-}"
    printf 'ROLLBACK_CREATED_AT=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"$state_file"
  chmod 600 "$state_file"
}

rollback_value() {
  local key="$1"
  local state_file="$(state_dir)/rollback.env"
  awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$state_file" 2>/dev/null
}

perform_rollback() {
  local api_image web_image override_file status
  if [[ -n "${RHD_INSTANCE_ID:-}" && "$(rollback_value ROLLBACK_INSTANCE_ID)" != "$RHD_INSTANCE_ID" ]]; then
    rhd_die "rollback state does not belong to the selected deployment instance"
  fi
  api_image="$(rollback_value ROLLBACK_API_IMAGE)"
  web_image="$(rollback_value ROLLBACK_WEB_IMAGE)"
  [[ -n "$api_image" && -n "$web_image" ]] || rhd_die "no complete rollback state is available"
  docker image inspect "$api_image" >/dev/null 2>&1 || rhd_die "rollback API image is missing: ${api_image}"
  docker image inspect "$web_image" >/dev/null 2>&1 || rhd_die "rollback Web image is missing: ${web_image}"

  override_file="$(mktemp "${TMPDIR:-/tmp}/remotehelpdesk-rollback.XXXXXX.yml")"
  {
    printf 'services:\n'
    printf '  api:\n'
    printf '    image: %s\n' "$api_image"
    printf '  web:\n'
    printf '    image: %s\n' "$web_image"
  } >"$override_file"

  status=0
  rhd_compose_with_override "$override_file" up -d --no-deps --no-build api || status=1
  if [[ "$status" == "0" ]]; then
    rhd_wait_for_service api 180 || status=1
  fi
  rhd_compose_with_override "$override_file" up -d --no-deps --no-build web || status=1
  if [[ "$status" == "0" ]]; then
    rhd_wait_for_service web 120 || status=1
  fi
  rm -f "$override_file"
  [[ "$status" == "0" ]] || rhd_die "application rollback failed; inspect ./rhdctl doctor --logs"
  rhd_log "application images rolled back; database changes were not reversed"
}

validate_restore_runtime() {
  local backup_file="$1" temporary_config summary status=0
  if ! rhd_backup_config_managed; then return 0; fi
  # Check historical secret references as the ordinary API user BEFORE stopping
  # traffic or replacing the database. Host/root readability alone is insufficient.
  temporary_config="$(mktemp "$RHD_PROJECT_CONFIG_DIR/.restore-check.XXXXXX.json")"
  if ! cp "${backup_file}.config.json" "$temporary_config" || ! chmod 644 "$temporary_config"; then
    rm -f "$temporary_config"
    return 1
  fi
  summary="$(rhd_backup_config_summary "$temporary_config")" || status=1
  if [[ "$status" == 0 ]]; then
    rhd_compose run --rm --no-deps api /app/remotehelpdesk \
      -check-project-config "/app/project-config/$(basename "$temporary_config")" \
      -project-tenant "$RHD_PROJECT_CONFIG_TENANT_ID" \
      -project-environment "$RHD_PROJECT_ENVIRONMENT" \
      -project-digest "${summary#*|}" -project-secret-dir /run/project-secrets || status=1
  fi
  rm -f "$temporary_config"
  [[ "$status" == 0 ]] || {
    rhd_warn "ordinary API cannot read the backup's configuration/secrets; restore did not stop or replace the current application"
    return 1
  }
}

sync_configuration_digest() {
  [[ -n "${RHD_INSTANCE_ID:-}" ]] || rhd_die "sync-config-digest requires a managed instance env file"
  local bundle checker digest summary
  bundle="$RHD_PROJECT_CONFIG_FILE"
  checker="$(rhd_absolute_path "$(rhd_env_value RHD_PROJECT_CONFIG_CHECKER ../../dist/remotehelpdesk)")"
  [[ -f "$bundle" && ! -L "$bundle" ]] || rhd_die "the instance's current.json is missing or is a symlink"
  [[ -x "$checker" ]] || rhd_die "build the release's configuration checker before synchronizing its digest"
  # Backup packages can be compact JSON from PostgreSQL. Parse JSON rather than
  # depending on a particular pretty-print layout when recovering a digest.
  summary="$(python3 "$RHD_REPO_ROOT/scripts/lib/deployment-backup-config.py" summary "$bundle")" || rhd_die "current.json lacks valid configuration metadata"
  digest="${summary#*|}"
  "$checker" -check-project-config "$bundle" \
    -project-tenant "$RHD_PROJECT_CONFIG_TENANT_ID" \
    -project-environment "$RHD_PROJECT_ENVIRONMENT" \
    -project-digest "$digest" -project-secret-dir "$RHD_PROJECT_SECRET_DIR"
  rhd_compose run --rm --no-deps --entrypoint /bin/sh api -ec 'test -r /app/config/config.yaml' || {
    rhd_die "the ordinary API user cannot read runtime config.yaml; correct its ownership or ACLs, then run sync-config-digest"
  }
  # Check with the ordinary non-root API user and read-only mounts as well as
  # the host checker. Do not weaken secret permissions to make this pass.
  rhd_compose run --rm --no-deps api /app/remotehelpdesk \
    -check-project-config /app/project-config/current.json \
    -project-tenant "$RHD_PROJECT_CONFIG_TENANT_ID" \
    -project-environment "$RHD_PROJECT_ENVIRONMENT" \
    -project-digest "$digest" -project-secret-dir /run/project-secrets || {
      rhd_die "API cannot read or validate the bundle/secrets; correct instance file ownership or ACLs, then run sync-config-digest"
    }
  rhd_set_env_value RHD_PROJECT_CONFIG_DIGEST "$digest" "$RHD_ENV_FILE" || {
    rhd_die "current.json is preserved but the env digest was not saved; correct env permissions and run sync-config-digest"
  }
  export RHD_PROJECT_CONFIG_DIGEST="$digest"
  rhd_log "validated and pinned configuration digest for ${RHD_INSTANCE_ID}"
}

case "$command_name" in
  init)
    [[ $# -eq 0 ]] || rhd_die "init does not accept additional arguments"
    [[ ! -e "$RHD_ENV_FILE" ]] || rhd_die "environment file already exists: ${RHD_ENV_FILE}"
    rhd_require_command openssl
    mkdir -p "$(dirname "$RHD_ENV_FILE")"
    cp "$SCRIPT_DIR/.env.example" "$RHD_ENV_FILE"
    chmod 600 "$RHD_ENV_FILE"
    rhd_set_env_value IMAGE_TAG "private-$(date -u +%Y%m%dT%H%M%SZ)" "$RHD_ENV_FILE"
    rhd_set_env_value POSTGRES_PASSWORD "$(openssl rand -hex 24)" "$RHD_ENV_FILE"
    rhd_set_env_value REDIS_PASSWORD "$(openssl rand -hex 24)" "$RHD_ENV_FILE"
    rhd_set_env_value RHD_BOOTSTRAP_ADMIN_PASSWORD "$(openssl rand -hex 16)" "$RHD_ENV_FILE"
    rhd_set_env_value MINIO_ROOT_PASSWORD "$(openssl rand -hex 24)" "$RHD_ENV_FILE"
    rhd_set_env_value CUSTOMER_SESSION_SECRET "$(openssl rand -hex 32)" "$RHD_ENV_FILE"
    rhd_set_env_value MCP_SERVER_TOKEN "$(openssl rand -hex 32)" "$RHD_ENV_FILE"
    rhd_set_env_value ENCRYPTION_KEY "$(openssl rand -hex 32)" "$RHD_ENV_FILE"
    chmod 600 "$RHD_ENV_FILE"
    rhd_log "created ${RHD_ENV_FILE} with generated base secrets"
    rhd_log "edit RHD_PUBLIC_URL and MINIO_PUBLIC_ENDPOINT, then run ./rhdctl preflight"
    ;;

  preflight)
    bash "$SCRIPT_DIR/preflight.sh" --env-file "$RHD_ENV_FILE" "$@"
    ;;

  initialize-config)
    [[ -n "${RHD_INSTANCE_ID:-}" ]] || rhd_die "initialize-config requires a generated managed instance env file"
    document=""
    tenant_name=""
    admin_user_id=""
    admin_username=""
    admin_password_file=""
    admin_args=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --document)
          [[ $# -ge 2 ]] || rhd_die "--document requires a raw configuration path"
          document="$2"
          shift 2
          ;;
        --tenant-name)
          [[ $# -ge 2 ]] || rhd_die "--tenant-name requires a company display name"
          tenant_name="$2"
          shift 2
          ;;
        --admin-user-id)
          [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] || rhd_die "--admin-user-id requires a positive user ID"
          admin_user_id="$2"
          shift 2
          ;;
        --admin-username)
          [[ $# -ge 2 && -n "$2" ]] || rhd_die "--admin-username requires a username"
          admin_username="$2"
          shift 2
          ;;
        --admin-password-file)
          [[ $# -ge 2 ]] || rhd_die "--admin-password-file requires a file path"
          admin_password_file="$2"
          shift 2
          ;;
        *) rhd_die "unknown initialize-config option: $1" ;;
      esac
    done
    [[ -n "$document" && -n "$tenant_name" ]] || rhd_die "initialize-config requires --document PATH and --tenant-name NAME"
    document="$(input_file_path "$document")"
    [[ -f "$document" && ! -L "$document" && "$(dirname "$document")" == "$RHD_PROJECT_CONFIG_DIR" ]] || rhd_die "raw document must be a regular file directly in this instance's project-config directory"
    if [[ -n "$admin_user_id" ]]; then
      [[ -z "$admin_username$admin_password_file" ]] || rhd_die "select an existing admin user OR a new username/password file"
      admin_args=(-project-admin-user-id "$admin_user_id")
    elif [[ -n "$admin_username$admin_password_file" ]]; then
      [[ -n "$admin_username" && -n "$admin_password_file" ]] || rhd_die "new administrators require both username and password file"
      admin_password_file="$(input_file_path "$admin_password_file")"
      expected_password_file="$RHD_PROJECT_SECRET_DIR/$RHD_PROJECT_CONFIG_TENANT_ID/$RHD_PROJECT_ENVIRONMENT/bootstrap-admin-password"
      [[ "$admin_password_file" == "$expected_password_file" && -f "$admin_password_file" && ! -L "$admin_password_file" ]] || rhd_die "administrator password file must be this instance's private bootstrap-admin-password file"
      admin_args=(-project-admin-username "$admin_username" -project-admin-password-file "/run/project-secrets/$RHD_PROJECT_CONFIG_TENANT_ID/$RHD_PROJECT_ENVIRONMENT/bootstrap-admin-password")
    fi
    acquire_deploy_lock
    bash "$SCRIPT_DIR/preflight.sh" --env-file "$RHD_ENV_FILE" --strict --initialize-config "$document"
    prepare_directories
    rhd_compose pull postgres
    rhd_compose build api
    rhd_compose up -d postgres
    rhd_wait_for_service postgres 180
    # Only this explicit one-off initialization can write project-config. Use
    # the operator's UID so new files remain manageable on the host.
    rhd_compose run --rm --no-deps --user "$(id -u):$(id -g)" \
      --volume "$RHD_PROJECT_CONFIG_DIR:/app/project-config:rw" api /app/remotehelpdesk \
      -config /app/config/config.yaml \
      -initialize-project-config "/app/project-config/$(basename "$document")" \
      -project-output /app/project-config/current.json \
      -project-tenant "$RHD_PROJECT_CONFIG_TENANT_ID" \
      -project-environment "$RHD_PROJECT_ENVIRONMENT" \
      -project-secret-dir /run/project-secrets -project-tenant-name "$tenant_name" "${admin_args[@]}"
    # Configuration contains references, not credentials. Secrets remain in the
    # separate protected directory; the normal API must be able to read this file.
    chmod 644 "$RHD_PROJECT_CONFIG_FILE"
    sync_configuration_digest
    rhd_log "instance configuration initialized; run install to start application services"
    ;;

  sync-config-digest)
    [[ $# -eq 0 ]] || rhd_die "sync-config-digest does not accept additional arguments"
    acquire_deploy_lock
    sync_configuration_digest
    ;;

  install)
    [[ $# -eq 0 ]] || rhd_die "install does not accept additional arguments"
    acquire_deploy_lock
    run_preflight
    prepare_directories
    rhd_log "pulling dependency images"
    rhd_compose pull postgres redis qdrant minio minio-init
    rhd_log "building application images"
    rhd_compose build api web
    rhd_log "starting dependencies"
    rhd_compose up -d postgres redis qdrant minio minio-init
    rhd_wait_for_service postgres 180
    rhd_wait_for_service redis 120
    rhd_wait_for_service qdrant 180
    rhd_wait_for_service minio 180
    rhd_wait_for_job minio-init 120
    rhd_log "starting API"
    rhd_compose run --rm --no-deps api /app/remotehelpdesk -migrate -apply-project-config
    rhd_compose up -d api
    rhd_wait_for_service api 240
    rhd_log "starting Web"
    rhd_compose up -d web
    rhd_wait_for_service web 180
    run_doctor
    ;;

  upgrade)
    [[ $# -eq 0 ]] || rhd_die "upgrade does not accept additional arguments"
    acquire_deploy_lock
    run_preflight
    api_container="$(rhd_service_container_id api)"
    web_container="$(rhd_service_container_id web)"
    [[ -n "$api_container" && -n "$web_container" ]] || rhd_die "install the application before running upgrade"
    prepare_directories
    rhd_log "creating and validating a pre-upgrade database backup"
    run_backup
    run_restore_drill "$RHD_LAST_BACKUP"

    rollback_suffix="${RHD_PROJECT_NAME}-$(date -u +%Y%m%dT%H%M%SZ)"
    image_name="$(rhd_env_value IMAGE_NAME remotehelpdesk)"
    rollback_api="${image_name}-api:rollback-${rollback_suffix}"
    rollback_web="${image_name}-web:rollback-${rollback_suffix}"
    docker image tag "$(docker inspect --format '{{.Image}}' "$api_container")" "$rollback_api"
    docker image tag "$(docker inspect --format '{{.Image}}' "$web_container")" "$rollback_web"
    save_rollback_state "$rollback_api" "$rollback_web"

    rhd_log "building the new application images"
    if ! rhd_compose build api web; then
      rhd_die "build failed; running containers were not changed"
    fi

    rhd_log "switching API"
    rhd_compose run --rm --no-deps api /app/remotehelpdesk -migrate -apply-project-config
    if ! rhd_compose up -d --no-deps api || ! rhd_wait_for_service api 240; then
      rhd_warn "API cutover failed; restoring previous application images"
      perform_rollback
      exit 1
    fi

    rhd_log "switching Web"
    if ! rhd_compose up -d --no-deps web || ! rhd_wait_for_service web 180; then
      rhd_warn "Web cutover failed; restoring previous application images"
      perform_rollback
      exit 1
    fi

    if ! run_doctor; then
      rhd_warn "post-upgrade diagnosis failed; restoring previous application images"
      perform_rollback
      exit 1
    fi
    rhd_log "upgrade completed; rollback images are recorded in $(state_dir)/rollback.env"
    ;;

  rollback)
    [[ $# -eq 0 ]] || rhd_die "rollback does not accept additional arguments"
    acquire_deploy_lock
    perform_rollback
    run_doctor
    ;;

  doctor)
    run_doctor "$@"
    ;;

  status)
    [[ $# -eq 0 ]] || rhd_die "status does not accept additional arguments"
    rhd_compose ps -a
    ;;

  logs)
    if [[ $# -gt 1 ]]; then
      rhd_die "logs accepts at most one service name"
    fi
    if [[ $# -eq 1 ]]; then
      rhd_compose logs --tail 200 -f "$1"
    else
      rhd_compose logs --tail 200 -f
    fi
    ;;

  backup)
    [[ $# -eq 0 ]] || rhd_die "backup does not accept additional arguments"
    run_preflight
    run_backup
    ;;

  restore-drill)
    [[ $# -le 1 ]] || rhd_die "restore-drill accepts at most one backup file"
    run_preflight
    run_restore_drill "${1:-}"
    ;;

  restore)
    [[ $# -eq 3 && "$2" == "--confirm" ]] || rhd_die "usage: ./rhdctl restore FILE --confirm DB_NAME"
    backup_file="$(input_file_path "$1")"
    expected_database="$3"
    configured_database="$(rhd_env_value POSTGRES_DB cs_ai_agent)"
    [[ "$expected_database" == "$configured_database" ]] || rhd_die "confirmation does not match configured database: ${configured_database}"
    [[ -s "$backup_file" ]] || rhd_die "backup is missing or empty: ${backup_file}"
    # Reject another environment's dump before even stopping application traffic.
    rhd_postgres_tool_environment
    source "$RHD_REPO_ROOT/scripts/lib/postgres-tools.sh"
    source "$RHD_REPO_ROOT/scripts/lib/deployment-backup-identity.sh"
    rhd_backup_verify_identity "$backup_file"
    if rhd_backup_config_managed; then
      python3 "$RHD_BACKUP_HELPER_DIR/deployment-backup-config.py" check-target "${backup_file}.config.json"
    fi
    acquire_deploy_lock
    run_preflight
    validate_restore_runtime "$backup_file"
    rhd_log "creating a safety backup before destructive restore"
    BACKUP_PRESERVE_FILE="$backup_file" run_backup
    rhd_postgres_tool_environment
    rhd_log "stopping application containers for database restore"
    rhd_compose stop web api
    if ! (
      cd "$RHD_DEPLOY_DIR"
      FORCE=1 bash "$RHD_REPO_ROOT/scripts/restore-db.sh" "$backup_file"
    ); then
      rhd_die "database/configuration restore failed; application remains stopped. Safety backup is preserved in $(backup_dir); inspect and recover before restarting"
    fi
    rhd_log "database restore completed; restart and diagnose the application"
    # restore-db atomically replaced the env digest. Compose otherwise retains
    # the previous exported shell value and would restart with mismatched config.
    rhd_load_instance_settings || rhd_die "restored instance settings cannot be loaded; application remains stopped"
    rhd_postgres_tool_environment
    rhd_compose up -d api web
    rhd_wait_for_service api 240
    rhd_wait_for_service web 180
    run_doctor
    ;;

  monitoring-up)
    [[ $# -eq 0 ]] || rhd_die "monitoring-up does not accept additional arguments"
    [[ "$(rhd_env_value RHD_MONITORING_ENABLED 0)" == "1" ]] || rhd_die "set RHD_MONITORING_ENABLED=1 before starting monitoring"
    acquire_deploy_lock
    run_preflight
    prepare_directories
    rhd_monitoring_compose up -d postgres-exporter redis-exporter node-exporter alertmanager prometheus
    monitoring_status
    ;;

  monitoring-status)
    [[ $# -eq 0 ]] || rhd_die "monitoring-status does not accept additional arguments"
    monitoring_status
    ;;

  monitoring-stop)
    [[ $# -eq 0 ]] || rhd_die "monitoring-stop does not accept additional arguments"
    rhd_monitoring_compose stop prometheus alertmanager node-exporter redis-exporter postgres-exporter
    ;;

  stop)
    [[ $# -eq 0 ]] || rhd_die "stop does not accept additional arguments"
    rhd_compose stop web api
    ;;

  *)
    usage >&2
    rhd_die "unknown command: ${command_name}"
    ;;
esac
