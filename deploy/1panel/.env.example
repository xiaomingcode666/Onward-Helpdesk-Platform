# RemoteHelpDesk private deployment environment.
# Recommended: run ./rhdctl init, then edit the generated .env.

IMAGE_NAME=remotehelpdesk
IMAGE_TAG=CHANGE_ME_RELEASE_TAG
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7-alpine
QDRANT_IMAGE=qdrant/qdrant:latest
MINIO_IMAGE=minio/minio:latest
MINIO_CLIENT_IMAGE=minio/mc:latest
PNPM_REGISTRY=https://registry.npmjs.org
GOPROXY=https://proxy.golang.org,direct
APP_BIND_IP=127.0.0.1
APP_PORT=8083
RHD_PUBLIC_URL=https://helpdesk.example.com
MINIO_PUBLIC_ENDPOINT=https://files.helpdesk.example.com
TZ=Asia/Shanghai
RHD_DATA_DIR=./volumes
RHD_BACKUP_DIR=./backups
RHD_STATE_DIR=./.state
RHD_CONFIG_FILE=./remotehelpdesk.yaml
RHD_MIN_FREE_GB=10
RHD_DOCKER_MIN_FREE_GB=8
BACKUP_RETENTION_COUNT=30
RHD_METRICS_DIR=./metrics
# Enable after the public reverse proxy and DNS are ready.
RHD_DOCTOR_CHECK_PUBLIC=0

# Optional monitoring profile. Pin these to versions or digests approved by
# the delivery environment before launch.
RHD_MONITORING_ENABLED=0
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:latest
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:latest
NODE_EXPORTER_IMAGE=prom/node-exporter:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
ALERTMANAGER_IMAGE=quay.io/prometheus/alertmanager:latest
PROMETHEUS_BIND_IP=127.0.0.1
PROMETHEUS_PORT=9090
ALERTMANAGER_BIND_IP=127.0.0.1
ALERTMANAGER_PORT=9093
RHD_ALERTMANAGER_CONFIG_FILE=./alertmanager.yml

# Bind databases and management ports to loopback. Put HTTPS in front of the
# application and MinIO API through 1Panel/OpenResty or another reverse proxy.
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND_IP=127.0.0.1
REDIS_PORT=6379
QDRANT_BIND_IP=127.0.0.1
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
MINIO_BIND_IP=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_BIND_IP=127.0.0.1
MINIO_CONSOLE_PORT=9001

# These values are embedded in the public frontend bundle. Keep them blank in
# every real deployment. Test credentials belong in an operator-only test env.
NEXT_PUBLIC_LOCAL_LOGIN_PLATFORM_PASSWORD=
NEXT_PUBLIC_LOCAL_LOGIN_ENTERPRISE_PASSWORD=
NEXT_PUBLIC_LOCAL_LOGIN_PARTNER_PASSWORD=
NEXT_PUBLIC_LOCAL_LOGIN_CUSTOMER_PASSWORD=

POSTGRES_DB=cs_ai_agent
POSTGRES_USER=cs_ai_agent
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Used only when the database has no bootstrap platform administrator. Changing
# this value later does not reset an existing account password.
RHD_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_BOOTSTRAP_ADMIN_PASSWORD

MINIO_ROOT_USER=remotehelpdesk
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET=remotehelpdesk-assets
MINIO_REGION=us-east-1
MINIO_SIGNED_URL_EXPIRE_SECONDS=600

CUSTOMER_SESSION_SECRET=CHANGE_ME_CUSTOMER_SESSION_SECRET_32
MCP_SERVER_TOKEN=CHANGE_ME_MCP_SERVER_TOKEN_32
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_32
# Optional comma-separated old encryption seeds. Use only during a controlled
# migration and remove after all imported credentials have been re-saved.
ENCRYPTION_KEY_FALLBACKS=
ALLOW_LEGACY_ENCRYPTION_FALLBACK=0

# Leave Jitsi blank when video collaboration is not deployed. For authenticated
# Jitsi, set all values below and use the same app id and secret on both sides.
JITSI_URL=
JITSI_DOMAIN=
JITSI_APP_ID=
JITSI_APP_SECRET=
JITSI_WEBHOOK_SECRET=
JITSI_REQUIRE_AUTH=false
JITSI_TOKEN_TTL_MINUTES=7200

SPEECH_PROVIDER=disabled
SPEECH_MOCK_SEGMENT_DURATION_MS=2000
XFYUN_RTASR_APP_ID=
XFYUN_RTASR_API_KEY=
XFYUN_RTASR_ENDPOINT=wss://rtasr.xfyun.cn/v1/ws
XFYUN_RTASR_DOMAIN=
XFYUN_TRANSLATION_ENABLED=false
XFYUN_TRANSLATION_API_SECRET=
XFYUN_TRANSLATION_ENDPOINT=https://itrans.xfyun.cn/v2/its
XFYUN_TRANSLATION_TARGET_LANGUAGE=en
SPEECH_JIGASI_ENABLED=false
SPEECH_JIGASI_SHARED_SECRET=
SPEECH_JIGASI_MAX_PARTICIPANT_STREAMS=8
SPEECH_JIGASI_MAX_CONCURRENT_STREAMS=32

MEETING_AR_PROVIDER=disabled
MEETING_AR_ENDPOINT=
MEETING_AR_API_KEY=
MEETING_AR_HEALTH_PATH=/health

LLM_SOURCE=auto
EMBEDDING_SOURCE=auto
RHD_SUB2API_BASE_URL=
# Required for platform sync, health checks, tenant provisioning and product key provisioning.
# Use Sub2API settings.admin_api_key; do not use a normal user/model API key here.
RHD_SUB2API_ADMIN_API_KEY=
# Optional legacy/default model request key. If admin key is empty, compose falls
# back to this value for compatibility with older environments.
RHD_SUB2API_DEFAULT_KEY=
RHD_SUB2API_DEFAULT_MODEL=
RHD_SUB2API_LLM_MODEL=
RHD_SUB2API_EMBEDDING_MODEL=
RHD_SUB2API_EMBEDDING_DIM=
RHD_OPENAI_API_KEY=
RHD_OPENAI_BASE_URL=
RHD_LLM_MODEL=
RHD_EMBEDDING_MODEL=text-embedding-v3
RHD_EMBEDDING_DIM=1024
RHD_LLM_FALLBACK_MODEL=
LLM_FALLBACK_TIMEOUT=30s
LLM_FAILOVER_ATTEMPT_TIMEOUT=15s
LLM_FAILOVER_CIRCUIT_COOLDOWN=60s

# Public marketing lead notification recipient. SMTP settings must also be configured.
DEMO_REQUEST_RECIPIENT=

# Used only by the explicit restore-db tools profile. A clean install does not
# import demo or production data automatically.
RHD_RESTORE_DATA_DIR=./backups
DB_DUMP_FILE=backup.dump
